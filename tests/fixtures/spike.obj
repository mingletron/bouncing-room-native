# A five-sided spike: nothing in the room's own primitives looks like this, so a
# passing pixel check proves the imported mesh is on screen, not a stand-in.
o spike
v -0.50 -0.90 -0.40
v  0.55 -0.85 -0.30
v  0.45 -0.95  0.50
v -0.60 -0.88  0.35
v  0.02  2.40 -0.05
vn 0 -1 0
vn -0.4 0.2 0.9
vn 0.95 0.2 0.1
vn -0.1 0.2 -0.97
vn 0.5 0.3 -0.8
f 1//1 2//1 3//1
f 1//1 3//1 4//1
f 1//2 4//2 5//2
f 4//3 3//3 5//3
f 3//4 2//4 5//4
f 2//5 1//5 5//5
